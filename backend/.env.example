NODE_ENV=development
PORT=5000
MONGODB_URI=
JWT_ACCESS_SECRET=replace_me_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_me_with_another_long_random_secret
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# Enable outbound email only after configuring the provider credentials above.
SMTP_SECURE=false
# SMTP_SECURE should be true for implicit TLS (commonly port 465); use false for STARTTLS (commonly port 587).

# Shipping defaults are a project policy, not carrier quotes. Configure actual markets and rates before launch.
SHIPPING_COUNTRIES=MA
SHIPPING_COST_EUR=15
FREE_SHIPPING_THRESHOLD_EUR=200

# Optional image hosting config
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
